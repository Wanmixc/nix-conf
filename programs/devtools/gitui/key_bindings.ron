// hjkl movement, help moved to '?'.
// Omitted actions keep gitui's defaults, and arrow keys keep working.
(
    // Move help off 'h' onto '?'
    // The terminal delivers '?' as the already-shifted Char('?') with no
    // modifier bits, so modifiers must be empty for the binding to fire.
    open_help: Some(( code: Char('?'), modifiers: "")),

    // hjkl as arrow keys
    move_left:  Some(( code: Char('h'), modifiers: "")),
    move_right: Some(( code: Char('l'), modifiers: "")),
    move_up:    Some(( code: Char('k'), modifiers: "")),
    move_down:  Some(( code: Char('j'), modifiers: "")),
)
